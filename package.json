{
  "name": "melora",
  "version": "1.0.0",
  "description": "Premium Production-grade Discord Music Bot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "deploy": "node --loader ts-node/esm scripts/deploy-commands.ts",
    "postinstall": "node scripts/patch-shoukaku.cjs"
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "lavalink"
  ],
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "shoukaku": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
