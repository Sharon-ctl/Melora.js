{
  "name": "melora",
  "version": "1.0.0",
  "description": "A lightweight, high-performance Discord music bot built with TypeScript and Lavalink.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "deploy": "node --loader ts-node/esm scripts/deploy-commands.ts",
    "postinstall": "node scripts/patch-shoukaku.cjs"
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "lavalink"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^18.0.9",
    "shoukaku": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
